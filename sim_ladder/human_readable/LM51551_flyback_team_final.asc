TEXT -448 -160 Left 2 ;1. INPUT: 9-12.6 V supply (0.12 ohm source resistance, 200 nH leads), input capacitors, UVLO divider
TEXT -256 144 Left 1 ;Cin2 = 8 x 10 uF X7R (derated)
TEXT -48 144 Left 1 ;Cbias: at the BIAS pin
TEXT 128 736 Left 2 ;2. CONTROLLER: LM51551 (TI model), soft start (Css + Qss), current sense
TEXT 128 784 Left 1 ;FB is grounded: regulation is done by the TL431 + optocoupler pulling COMP down
TEXT 752 -160 Left 2 ;3. POWER STAGE: T1, T2 = Coilcraft DA2034-ALD (10 uH +/-10 %, 1:10), primaries in parallel
TEXT 720 176 Left 1 ;Rsnub = 3 x 300 ohm, 2 W
TEXT 1088 -64 Left 2 ;T1
TEXT 1088 256 Left 2 ;T2
TEXT 624 560 Left 1 ;Winding capacitance, primary to secondary (assumed):
TEXT 1216 -224 Left 2 ;4. +HV RAIL: ES1J, 30 uF (3 x 10 uF 200 V), 1 uF X7R, SMBJ130A, LC filter (100 uH + ferrite bead) with damping
TEXT 1344 144 Left 1 ;Co7 / Cf1: 1 uF 250 V X7R at 0.45 uF
TEXT 2112 -48 Left 1 ;+HV out
TEXT 1216 704 Left 2 ;5. -HV RAIL (unregulated, follows +HV): same parts, polarity reversed
TEXT 2112 432 Left 1 ;-HV out
TEXT -224 864 Left 2 ;6. MAIN FEEDBACK on +HV (before the filter): 102.5 V = 2.495 V x (1 + 99.6k / 2.49k); TL431B, MMBTA42 cascode, TCMT1108
TEXT 400 1504 Left 1 ;Start-up network: R21 = 2 x 499k, C21 = 2.2 uF 250 V (about 1.3 uF at 100 V), BAS21 diodes
TEXT -224 1632 Left 1 ;RMfbt = 3 x 33.2k 0.1 %, RMbb = 3 x 110k, RMled = 3 x 14.7k (1206 parts in series for voltage rating)
TEXT 992 864 Left 2 ;7. +HV TRIP at 109.8 V: the TL431 acts as a comparator; the opto pulls COMP low and fires the latch
TEXT 992 1632 Left 1 ;RPfbt = 3 x 33.2k, RPbb = 3 x 110k, RPled = 3 x 7.32k
TEXT 1888 864 Left 2 ;8. -HV TRIP: same circuit turned over (GND is its top rail, -HV its return)
TEXT 1888 1632 Left 1 ;RNfbt = 3 x 33.2k, RNbb = 3 x 110k, RNled = 3 x 7.32k
TEXT -960 224 Left 2 ;9. LATCH: once a trip fires, holds UVLO low until the supply is removed
TEXT -960 1824 Left 2 ;==== +/-102 V flyback: team final design (stim-power-supply repo: FINAL_DESIGN_FOR_LAYOUT_2026-11-15.md, sim_ladder/P9_final.net) with the TI LM51551 model ====
TEXT -960 1856 Left 2 ;Vin = supply voltage (9 to 12.6 V), Iload = load per rail (171 mA rated).
TEXT -960 1888 Left 2 ;STARTUP=0: output capacitors start charged and Css is 4.7 nF, so a 6 ms run reaches steady state (use this for the loop work).
TEXT -960 1920 Left 2 ;STARTUP=1: start from 0 V with the real 680 nF soft start (about 80 ms of simulation; slow at the 5 ns maximum step).
TEXT -960 1952 Left 2 ;The 5 ns maximum step is needed by the TI model: its start-up logic uses 15 ns internal pulses that a larger step skips.
TEXT -960 1984 Left 2 ;Assumed values (from the team simulation P9): transformer 11 uH / 9 uH, k = 0.9874 (0.25 uH leakage), 460 ohm core loss (Rpar),
TEXT -960 2016 Left 2 ;15 pF secondary self-capacitance (Cpar), 64 pF winding capacitance, 3 ohm per output electrolytic, X7R capacitors derated at their working voltage.
TEXT -960 2048 Left 2 ;Not drawn: Rcomp/Ccomp on COMP (footprints only), PGOOD (unused), the 9 V LDO for the analog board, test points.
TEXT -960 2128 Left 2 !.param Vin=9 Iload=171m STARTUP=0
TEXT -960 2168 Left 2 !.param ON=1-STARTUP Css={if(STARTUP,680n,4.7n)} TEND={if(STARTUP,80m,6m)}
TEXT -960 2208 Left 2 !K1 L1p L1s 0.9874
TEXT -960 2248 Left 2 !K2 L2p L2s 0.9874
TEXT -960 2288 Left 2 !.lib LM5155-Q1_TRANS.LIB
TEXT -960 2328 Left 2 !.tran 0 {TEND} 0 5n uic
TEXT -960 2368 Left 2 !.options abstol=1e-9 vntol=1e-5 reltol=0.003 cshunt=1e-15
TEXT 1280 2128 Left 2 !.meas TRAN Vhvp AVG V(HVP) FROM {TEND-1m} TO {TEND}\n.meas TRAN Vhvn AVG V(HVN) FROM {TEND-1m} TO {TEND}\n.meas TRAN Voutp AVG V(OUTP) FROM {TEND-1m} TO {TEND}\n.meas TRAN Ripple_outp PP V(OUTP) FROM {TEND-0.1m} TO {TEND}\n.meas TRAN Isw_pk MAX Id(M1) FROM {TEND-1m} TO {TEND}\n.meas TRAN Vcomp AVG V(COMP) FROM {TEND-1m} TO {TEND}\n.meas TRAN Uvlo_min MIN V(UVLO) FROM 1m TO {TEND}\n.meas TRAN Pin AVG V(VIN)*I(Lbat) FROM {TEND-1m} TO {TEND}\n.meas TRAN Pout AVG V(OUTP)*V(OUTP)/(102.5/Iload)+V(OUTN)*V(OUTN)/(102.5/Iload) FROM {TEND-1m} TO {TEND}\n.meas TRAN Eff PARAM Pout/Pin
TEXT -960 2464 Left 2 !.model D_SS510C D(Is=10n Rs=0.1 N=1.5 Cjo=20p tt=20n BV=200)\n.model D_ES1J D(Is=5n Rs=0.25 N=2.2 Cjo=12p tt=40n BV=600)\n.model D_TVS D(Is=1p N=1 BV=150 Ibv=1m Cjo=60p)\n.model DZ12 D(Is=1p N=1 BV=12 Ibv=100u Cjo=30p)\n.model D_BAS21 D(Is=5n N=1.8 Rs=1 Cjo=2p BV=250 tt=50n)\n.model QHV NPN(Is=1e-14 Bf=80 Vaf=200 Cjc=4p Cje=20p Tf=1n Rb=10)\n.model Q3904 NPN(IS=1E-14 VAF=100 BF=300 IKF=0.4 BR=4 CJC=4E-12 CJE=8E-12 RB=20 RC=0.1 RE=0.1 TR=250E-9 TF=350E-12)\n.model Q3906 PNP(IS=1E-14 VAF=100 BF=200 IKF=0.4 BR=4 CJC=5E-12 CJE=10E-12 RB=20 RC=0.1 RE=0.1 TR=250E-9 TF=450E-12)\n.model CSD19531 VDMOS(Rg=1.3 Vto=2.7 Rd=2.5m Rs=1.5m Rb=3m Kp=150 Cgdmax=1.2n Cgdmin=15p Cgs=2.7n Cjo=1.6n Is=20p)
TEXT 1280 2584 Left 2 !.subckt TL431_WB K A REF\nVr RI A 2.495\nIref REF A 2u\nBg K A I=0.05*(1+tanh(40*(V(REF)-V(RI))))*(0.5+0.5*tanh((V(K,A)-1.8)*3))\nCk K A 20p\nDclamp A K D_TL\nDmin A K D_Z36\n.model D_TL D(Is=1p N=1)\n.model D_Z36 D(Is=1p N=1 BV=36 Ibv=1m)\n.ends TL431_WB\n.subckt OPTO_WB A K C E\nDled A M D_LED\nVs M K 0\nBs N 0 V=I(Vs)\nRf N NF 1k\nCf NF 0 3n\nRc C CI 1\nBc CI E I=V(NF)*tanh(V(CI,E)*8)\nCce CI E 20p\n.model D_LED D(Is=1p N=2 Rs=1 Cjo=8p)\n.ends OPTO_WB
