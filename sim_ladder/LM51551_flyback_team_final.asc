TEXT 0 -96 Left 2 ;1. Battery (bench supply), input capacitors, UVLO divider
TEXT 0 224 Left 2 ;2. LM51551 controller (TI model), soft start, current sense
TEXT 0 704 Left 2 ;3. Two DA2034-ALD transformers, primaries in parallel (dot = top pin); winding capacitance; primary clamp
TEXT 0 1024 Left 2 ;4. +HV rail: ES1J, output capacitors, SMBJ130A, LC filter with damping, load
TEXT 0 1344 Left 2 ;5. -HV rail (unregulated, follows +HV): same parts turned over
TEXT 0 1664 Left 2 ;6. Main feedback on +HV (before the filter): 3x33.2k / 2.49k -> 102.5 V, TL431B, MMBTA42 cascode, TCMT1108
TEXT 0 2016 Left 2 ;7. +HV trip block: trips at 109.8 V; output pulls COMP down and fires the latch
TEXT 0 2368 Left 2 ;8. -HV trip block (same circuit turned over: GND is its positive side, -HV its return)
TEXT 0 2720 Left 2 ;9. Latch: holds UVLO low after a trip until the supply is removed
TEXT -16 -560 Left 2 ;==== Team final design (stim-power-supply repo, FINAL_DESIGN_FOR_LAYOUT_2026-11-15.md + sim_ladder/P9_final.net) with the TI LM51551 model ====
TEXT -16 -528 Left 2 ;Every pin carries a net label (no wires): parts with the same label are connected. GND = net 0 (output is NOT isolated, P-3).
TEXT -16 -496 Left 2 ;STARTUP=0: rails preset near 102 V, small Css so soft start finishes in ~0.5 ms, 6 ms run (use for the loop / steady state).
TEXT -16 -464 Left 2 ;STARTUP=1: start from 0 V with the real 680 nF soft start (about 70 ms to settle; long run at a 5 ns max step).
TEXT -16 -432 Left 2 ;TI model needs the small max step (5 ns): its start-up logic uses 15 ns internal pulses that a larger step skips.
TEXT -16 -400 Left 2 ;Simulation values that differ from the part value: Cin2 = 8 x 10 uF X7R derated to 40 uF; Co7/Co8/Cf1/Cf2 = 1 uF 250 V X7R at 0.45 uF;
TEXT -16 -368 Left 2 ;C21 = 2.2 uF 250 V at ~1.3 uF; Co1-6 3 ohm each, transformer 11 uH / 9 uH (+/-10 %), k=0.9874 (0.25 uH leakage), Rcore = core loss, all [ASSUME] from P9.
TEXT -16 -336 Left 2 ;Not drawn: Rcomp/Ccomp on COMP (footprints only, not fitted), PGOOD (unused), 9 V LDO (separate from the flyback), test points.
TEXT -16 -304 Left 2 ;FB1/FB2 ferrite beads are modelled as 1 uH + 0.1 ohm. Battery source resistance Rbat and lead inductance Lbat are assumptions.
TEXT 2400 -560 Left 2 !.param Vin=9 Iload=171m Vset=102.5 STARTUP=0
TEXT 2400 -520 Left 2 !.param ON=1-STARTUP Css={if(STARTUP,680n,4.7n)} TEND={if(STARTUP,80m,6m)}
TEXT 2400 -480 Left 2 !.param Lp1=11u Lp2=9u kc=0.9874 Rbat=0.12 CTR=1
TEXT 2400 -440 Left 2 !K1 L1p L1s {kc}
TEXT 2400 -400 Left 2 !K2 L2p L2s {kc}
TEXT 2400 -360 Left 2 !.lib LM5155-Q1_TRANS.LIB
TEXT 2400 -320 Left 2 !.tran 0 {TEND} 0 5n uic
TEXT 2400 -280 Left 2 !.ic V(SN)={-97*ON} V(SS2)={-97*ON} V(HVP)={102*ON} V(HVN)={-97*ON} V(OUTP)={102*ON} V(OUTN)={-97*ON} V(MKC)={25*ON} V(PKC)={101*ON} V(NKC)={-1.5*ON} V(NSS)={102*ON} V(PREF)={2.33*ON} V(NREF)={(-97+2.34)*ON} V(NBASE)={-85*ON} V(NK1)={-85.6*ON} V(MBASE)={12*ON} V(MK1)={11.4*ON} V(PBASE)={12*ON} V(PK1)={11.4*ON} V(MREF)={2.495*ON} V(LATCH_G)=0
TEXT 2400 -240 Left 2 !.options abstol=1e-9 vntol=1e-5 reltol=0.003 cshunt=1e-15
TEXT 2400 -200 Left 2 !.save V(VIN) V(UVLO) V(VCC) V(SS) V(COMP) V(GATE) V(CS) V(SW) V(SNS) V(SNUB) V(SP) V(SN) V(HVP) V(HVN) V(OUTP) V(OUTN) V(MKC) V(MREF) V(NSS) V(LATCH_G) I(L1p) I(L2p) I(Lbat) I(Dp) I(Dn) Id(M1)
TEXT 2400 -128 Left 2 !.meas TRAN Vhvp AVG V(HVP) FROM {TEND-1m} TO {TEND}\n.meas TRAN Vhvn AVG V(HVN) FROM {TEND-1m} TO {TEND}\n.meas TRAN Voutp AVG V(OUTP) FROM {TEND-1m} TO {TEND}\n.meas TRAN Ripple_outp PP V(OUTP) FROM {TEND-0.1m} TO {TEND}\n.meas TRAN Isw_pk MAX Id(M1) FROM {TEND-1m} TO {TEND}\n.meas TRAN Vcomp AVG V(COMP) FROM {TEND-1m} TO {TEND}\n.meas TRAN Uvlo_min MIN V(UVLO) FROM 1m TO {TEND}\n.meas TRAN Pin AVG V(VIN)*I(Lbat) FROM {TEND-1m} TO {TEND}\n.meas TRAN Pout AVG V(OUTP)*V(OUTP)/(Vset/Iload)+V(OUTN)*V(OUTN)/(Vset/Iload) FROM {TEND-1m} TO {TEND}\n.meas TRAN Eff PARAM Pout/Pin
TEXT 3500 1100 Left 2 !.model D_SS510C D(Is=10n Rs=0.1 N=1.5 Cjo=20p tt=20n BV=200)\n.model D_ES1J D(Is=5n Rs=0.25 N=2.2 Cjo=12p tt=40n BV=600)\n.model D_TVS D(Is=1p N=1 BV=150 Ibv=1m Cjo=60p)\n.model DZ12 D(Is=1p N=1 BV=12 Ibv=100u Cjo=30p)\n.model D_BAS21 D(Is=5n N=1.8 Rs=1 Cjo=2p BV=250 tt=50n)\n.model QHV NPN(Is=1e-14 Bf=80 Vaf=200 Cjc=4p Cje=20p Tf=1n Rb=10)\n.model Q3904 NPN(IS=1E-14 VAF=100 BF=300 IKF=0.4 BR=4 CJC=4E-12 CJE=8E-12 RB=20 RC=0.1 RE=0.1 TR=250E-9 TF=350E-12)\n.model Q3906 PNP(IS=1E-14 VAF=100 BF=200 IKF=0.4 BR=4 CJC=5E-12 CJE=10E-12 RB=20 RC=0.1 RE=0.1 TR=250E-9 TF=450E-12)\n.model CSD19531 VDMOS(Rg=1.3 Vto=2.7 Rd=2.5m Rs=1.5m Rb=3m Kp=150 Cgdmax=1.2n Cgdmin=15p Cgs=2.7n Cjo=1.6n Is=20p)
TEXT 3500 1600 Left 2 !.subckt TL431_WB K A REF\nVr RI A 2.495\nIref REF A 2u\nBg K A I=0.05*(1+tanh(40*(V(REF)-V(RI))))*(0.5+0.5*tanh((V(K,A)-1.8)*3))\nCk K A 20p\nDclamp A K D_TL\nDmin A K D_Z36\n.model D_TL D(Is=1p N=1)\n.model D_Z36 D(Is=1p N=1 BV=36 Ibv=1m)\n.ends TL431_WB\n.subckt OPTO_WB A K C E\nDled A M D_LED\nVs M K 0\nBs N 0 V=I(Vs)*CTR\nRf N NF 1k\nCf NF 0 3n\nRc C CI 1\nBc CI E I=V(NF)*tanh(V(CI,E)*8)\nCce CI E 20p\n.model D_LED D(Is=1p N=2 Rs=1 Cjo=8p)\n.ends OPTO_WB
